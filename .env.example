# Base URL of the dps-vet-web API (its app/api routes), no trailing slash.
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Google sign-in OAuth client IDs (public identifiers). Leave a platform's ID empty to hide the option there.
# Dev builds only (not Expo Go). The Google provider must also be enabled on the web API.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
